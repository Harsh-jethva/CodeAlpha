# Sample Suricata local rules

alert tcp any any -> any 22 (msg:"NIDS Possible SSH brute force scan"; flags:S; threshold:type both, track by_src, count 20, seconds 60; sid:1000001; rev:1;)
alert icmp any any -> any any (msg:"NIDS Possible ICMP sweep"; itype:8; threshold:type both, track by_src, count 10, seconds 30; sid:1000002; rev:1;)
alert http any any -> any any (msg:"NIDS Suspicious admin path access"; http_uri; content:"/admin"; nocase; sid:1000003; rev:1;)
