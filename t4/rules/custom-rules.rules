# Custom IDS Rules for Intrusion Detection
# SID range: 1000000-1009999 (Custom rules)

# ============================================
# SQL INJECTION DETECTION RULES
# ============================================

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"SQL Injection - UNION keyword"; flow:to_server,established; 
  content:"GET"; http_method; content:"UNION"; http_uri; 
  sid:1000001; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"SQL Injection - SELECT keyword in URI"; flow:to_server,established;
  content:"GET"; http_method; content:"SELECT"; http_uri; nocase;
  sid:1000002; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"SQL Injection - DROP TABLE attempt"; flow:to_server,established;
  content:"GET"; http_method; content:"DROP"; http_uri; nocase; content:"TABLE"; http_uri; nocase;
  sid:1000003; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"SQL Injection - OR 1=1 pattern"; flow:to_server,established;
  content:"GET"; http_method; content:"or+1%3d1"; http_uri; nocase;
  sid:1000004; rev:1; classtype:web-application-attack;)

# ============================================
# BUFFER OVERFLOW DETECTION
# ============================================

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Buffer Overflow - Long URL string"; 
  flow:to_server,established; content:"GET"; http_method; 
  http_uri; isdataat:!-1,relative; content_length:>10000;
  sid:1000010; rev:1; classtype:attempted-admin;)

alert tcp $EXTERNAL_NET any -> any any (msg:"Buffer Overflow - Excessive packet size";
  flow:to_server; dsize:>65000; sid:1000011; rev:1; classtype:attempted-admin;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"Buffer Overflow - SSH banner grab exploit";
  flow:to_server,established; content:"SSH"; offset:0; depth:3;
  content:!"|0a|"; msg:"SSH Payload"; sid:1000012; rev:1; classtype:attempted-admin;)

# ============================================
# PORT SCAN DETECTION
# ============================================

alert tcp any any -> $HOME_NET any (msg:"Port Scan - SYN probe detected"; 
  flow:to_server; flags:S,!ACK; detection_filter:track by_src,count 10,seconds 10;
  sid:1000020; rev:1; classtype:suspicious-tcp-traffic;)

alert tcp $EXTERNAL_NET any -> $HOME_NET [22,23,25,53,80,110,143,389,443,445,1433,1521,3306,3389,5432,5984,6379,7001,8080,8443,9200,11211,27017,50070] (msg:"Port Scan - Common service probes"; 
  flow:to_server,new; flags:S; detection_filter:track by_src,count 5,seconds 30;
  sid:1000021; rev:1; classtype:suspicious-tcp-traffic;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Port Scan - Nmap FIN scan detected";
  flow:to_server; flags:F,!ACK,!SYN; window:<1024;
  sid:1000022; rev:1; classtype:suspicious-tcp-traffic;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Port Scan - Nmap NULL scan detected";
  flow:to_server; flags:0; sid:1000023; rev:1; classtype:suspicious-tcp-traffic;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Port Scan - Nmap Xmas scan detected";
  flow:to_server; flags:FPU,!ACK,!SYN; sid:1000024; rev:1; classtype:suspicious-tcp-traffic;)

# ============================================
# COMMAND INJECTION DETECTION
# ============================================

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"Command Injection - Shell metacharacters in URL";
  flow:to_server,established; content:"GET"; http_method;
  content:"|3b|"; http_uri; sid:1000030; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"Command Injection - Backtick execution";
  flow:to_server,established; content:"GET"; http_method;
  content:"`"; http_uri; sid:1000031; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"Command Injection - Pipe operator";
  flow:to_server,established; content:"GET"; http_method;
  content:"|"; http_uri; sid:1000032; rev:1; classtype:web-application-attack;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS any (msg:"Command Injection - OR operator with command";
  flow:to_server,established; content:"GET"; http_method;
  content:"||"; http_uri; content:"wget|curl|bash|sh"; http_uri; nocase;
  sid:1000033; rev:1; classtype:web-application-attack;)

# ============================================
# MALWARE SIGNATURES
# ============================================

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Malware - Known malware domain detected";
  flow:to_server,established; http_host;
  content:".malware-domain.ru"; nocase; http_header; sid:1000040; rev:1; classtype:malware-cnc;)

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Malware - Botnet C&C communication pattern";
  flow:to_server; dsize:50<>150; sid:1000041; rev:1; classtype:malware-cnc;)

alert dns $EXTERNAL_NET any -> any 53 (msg:"Malware - DGA domain query attempt";
  dns_query; content:".tk"; isdataat:!-1,relative; nocase;
  sid:1000042; rev:1; classtype:malware-cnc;)

alert file-data (msg:"Malware - Suspicious executable signature";
  file_type:!jpeg,!png,!gif; file_size:>1000000;
  sid:1000043; rev:1; classtype:malware;)

# ============================================
# DDoS PATTERN DETECTION
# ============================================

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDoS - SYN flood pattern detected";
  flow:to_server; flags:S,!ACK; threshold:type both,track by_src,count 100,seconds 10;
  sid:1000050; rev:1; classtype:attempted-dos;)

alert icmp $EXTERNAL_NET any -> $HOME_NET any (msg:"DDoS - ICMP flood detected";
  threshold:type both,track by_src,count 50,seconds 5;
  sid:1000051; rev:1; classtype:attempted-dos;)

alert udp $EXTERNAL_NET any -> $HOME_NET 53 (msg:"DDoS - DNS amplification attack";
  flow:to_server; dsize:>512; threshold:type both,track by_src,count 30,seconds 5;
  sid:1000052; rev:1; classtype:attempted-dos;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"DDoS - HTTP GET flood pattern";
  flow:to_server,established; http_method; content:"GET";
  threshold:type both,track by_src,count 100,seconds 5;
  sid:1000053; rev:1; classtype:attempted-dos;)

# ============================================
# RECONNAISSANCE & SCANNING
# ============================================

alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - Zenmap HTTP user agent";
  flow:to_server,established; http_user_agent; content:"Zenmap"; nocase;
  sid:1000060; rev:1; classtype:attempted-recon;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - Nikto web scanner";
  flow:to_server,established; http_user_agent; content:"Nikto"; nocase;
  sid:1000061; rev:1; classtype:attempted-recon;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Reconnaissance - SQLMap parameter";
  flow:to_server,established; content:"GET"; http_method; 
  content:"id="; http_uri; content:"--"; http_uri; nocase;
  sid:1000062; rev:1; classtype:attempted-recon;)

# ============================================
# SUSPICIOUS PROTOCOL BEHAVIOR
# ============================================

alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"Suspicious SSH - Root login attempt";
  flow:to_server,established; content:"SSH-2.0"; offset:0; depth:7;
  content:"root"; msg:"SSH root login"; sid:1000070; rev:1; classtype:attempted-admin;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"Suspicious Telnet - Clear text credentials";
  flow:to_server,established; content:"telnet"; nocase; 
  sid:1000071; rev:1; classtype:attempted-admin;)

alert dns $EXTERNAL_NET any -> any 53 (msg:"Suspicious DNS - Possible DNS exfiltration";
  dns_query; isdataat:!-1,relative; dsize:>256;
  sid:1000072; rev:1; classtype:suspicious-protocol;)

# ============================================
# NETWORK ANOMALIES
# ============================================

alert tcp any any -> any any (msg:"Network Anomaly - Unusual port connection";
  flow:to_server; flags:S; detection_filter:track by_dst,count 50,seconds 10;
  sid:1000080; rev:1; classtype:suspicious-tcp-traffic;)

alert ip any any -> $HOME_NET any (msg:"Network Anomaly - Fragmented packets";
  fragbits:M; threshold:type both,track by_src,count 100,seconds 10;
  sid:1000081; rev:1; classtype:unusual-traffic;)

alert icmp any any -> $HOME_NET any (msg:"Network Anomaly - Large ICMP ping";
  icmp_id:!0; dsize:>1024; sid:1000082; rev:1; classtype:unusual-traffic;)

# ============================================
# EXPLOIT SIGNATURES
# ============================================

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Exploit - MS17-010 EternalBlue indicators";
  flow:to_server,established; content:"POST"; http_method;
  content:"RpcBindingHandle"; http_client_body; nocase;
  sid:1000090; rev:1; classtype:attempted-admin;)

alert tcp $EXTERNAL_NET any -> $HOME_NET 445 (msg:"Exploit - WannaCry spreading pattern";
  flow:to_server,established; dsize:>1000; threshold:type both,track by_src,count 10,seconds 5;
  sid:1000091; rev:1; classtype:malware;)

alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"Exploit - Shellshock CGI vulnerability";
  flow:to_server,established; http_method; content:"GET";
  content:"User-Agent"; http_header; content:"() {"; http_header;
  sid:1000092; rev:1; classtype:attempted-admin;)

# ============================================
# FILE TRANSFER MONITORING
# ============================================

alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"File Transfer - Suspicious FTP to external";
  flow:to_server,established; content:"USER"; offset:0; depth:5;
  sid:1000100; rev:1; classtype:suspicious-traffic;)

alert tcp $HOME_NET any -> $EXTERNAL_NET 443 (msg:"File Transfer - Large HTTPS transfer";
  flow:to_server,established; dsize:>100000000; 
  sid:1000101; rev:1; classtype:suspicious-traffic;)
