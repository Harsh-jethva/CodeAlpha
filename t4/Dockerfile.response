FROM python:3.9-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    iptables \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Copy response handler script
COPY scripts/response_handler.py .

# Create directories
RUN mkdir -p logs data

# Copy whitelist
COPY config/whitelist.txt . 2>/dev/null || true

# Install Python dependencies
RUN pip install --no-cache-dir \
    requests>=2.28.0

# Run the response handler
CMD ["python3", "response_handler.py", "--alert-file", "/app/data/processed_alerts.json"]
